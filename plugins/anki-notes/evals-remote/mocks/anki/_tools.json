  {
   "name": "anki_notes_create_batch",
   "description": "Create a bounded atomic batch of validated notes with one idempotency key.\n\n        With skip_duplicates, notes whose first field duplicates an existing note (or an\n        earlier note in the batch) are skipped instead of failing the batch; each result in\n        request order has status \"created\" (with note_id and card_ids) or \"duplicate\" (with\n        duplicate_of, the id of the note it duplicates).\n        Any other error still fails the whole batch.\n        ",
   "inputSchema": {
    "$defs": {
     "NoteCreateInput": {
      "additionalProperties": false,
      "properties": {
       "deck_id": {
        "exclusiveMinimum": 0,
        "title": "Deck Id",
        "type": "integer"
       },
       "note_type_id": {
        "exclusiveMinimum": 0,
        "title": "Note Type Id",
        "type": "integer"
       },
       "fields": {
        "additionalProperties": {
         "maxLength": 262144,
         "type": "string"
        },
        "propertyNames": {
         "maxLength": 512,
         "minLength": 1
        },
        "title": "Fields",
        "type": "object"
       },
       "tags": {
        "items": {
         "maxLength": 512,
         "minLength": 1,
         "type": "string"
        },
        "maxItems": 100,
        "title": "Tags",
        "type": "array"
       }
      },
      "required": [
       "deck_id",
       "note_type_id",
       "fields"
      ],
      "title": "NoteCreateInput",
      "type": "object"
     }
    },
    "additionalProperties": false,
    "properties": {
     "notes": {
      "items": {
       "$ref": "#/$defs/NoteCreateInput"
      },
      "title": "Notes",
      "type": "array"
     },
     "skip_duplicates": {
      "default": false,
      "title": "Skip Duplicates",
      "type": "boolean"
     },
     "idempotency_key": {
      "anyOf": [
       {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Idempotency Key"
     }
    },
    "required": [
     "notes"
    ],
    "title": "notes_create_batchArguments",
    "type": "object"
   },
   "outputSchema": {
    "additionalProperties": true,
    "title": "notes_create_batchDictOutput",
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false
   },
   "_meta": {
    "anki-mcp/sync": "incremental"
   }
