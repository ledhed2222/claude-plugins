   "inputSchema": {
    "additionalProperties": false,
    "properties": {
     "query": {
      "default": "",
      "maxLength": 4096,
      "title": "Query",
      "type": "string"
     },
     "offset": {
      "default": 0,
      "title": "Offset",
      "type": "integer",
      "minimum": 0
     },
     "limit": {
      "default": 100,
      "title": "Limit",
      "type": "integer",
      "minimum": 1,
      "maximum": 100
     },
     "include_fields": {
      "default": false,
      "title": "Include Fields",
      "type": "boolean"
     },
     "sync_before": {
